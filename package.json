{
  "name": "steamdesk",
  "productName": "SteamDesk",
  "version": "2.6.84",
  "description": "Steam 多账号管理、游戏库识别、饰品行情对照与批量上架工具（本地运行，不接触密码）",
  "main": "main.js",
  "author": "SteamDesk",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis",
    "dist:all": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "isomorphic-git": "^1.44.13",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.steamdesk.app",
    "productName": "SteamDesk",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "renderer/**/*",
      "icon.png",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "SteamDesk-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SteamDesk",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "portable": {
      "artifactName": "SteamDesk-${version}-portable.${ext}"
    }
  }
}
